# Copy this file to .env.local and fill in values when the integrations are built.
# These placeholder names may change when the authentication and database libraries are selected.
# Never put secrets in variables prefixed with NEXT_PUBLIC_.

# Local PostgreSQL connection string
DATABASE_URL=

# Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js session signing secret (generate a different random value per environment)
AUTH_SECRET=
# Local development origin; use the correct public origin in other environments.
AUTH_URL=http://localhost:3000

# Groq API credential
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Gemini is used for text-based question and rubric suggestions.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Optional backup for student-paper scanning (free model, zero-retention routing).
OPENROUTER_API_KEY=
