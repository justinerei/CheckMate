generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TEACHER
  ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  IDENTIFICATION
  ESSAY
}

enum SubmissionStatus {
  DRAFT
  IN_REVIEW
  FINALIZED
}

enum PageStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model User {
  id            String             @id @default(cuid())
  googleId      String             @unique
  email         String             @unique
  name          String
  role          UserRole           @default(TEACHER)
  enabled       Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  students      TeacherStudent[]
  quizzes       Quiz[]
  submissions   Submission[]
  batches       CheckingBatch[]
  keyChanges    AnswerKeyHistory[]
  resultChanges ResultHistory[]
}

model Student {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  teachers    TeacherStudent[]
  submissions Submission[]
}

model TeacherStudent {
  teacherId String
  studentId String
  createdAt DateTime @default(now())
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([teacherId, studentId])
  @@index([studentId])
}

model Quiz {
  id            String        @id @default(cuid())
  teacherId     String
  title         String
  paperSize     String        @default("A4")
  numbering     String        @default("CONTINUOUS")
  source        String        @default("BUILT")
  expectedPages Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  teacher       User          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  sections      QuizSection[]
  submissions   Submission[]
  batches       CheckingBatch[]

  @@index([teacherId])
}

model QuizSection {
  id            String     @id @default(cuid())
  quizId        String
  title         String
  instructions  String     @default("")
  answerStyle   String     @default("circle")
  position      Int
  defaultPoints Decimal    @default(1) @db.Decimal(8, 2)
  quiz          Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questions     Question[]

  @@unique([quizId, position])
}

model Question {
  id             String             @id @default(cuid())
  sectionId      String
  type           QuestionType
  text           String
  position       Int
  points         Decimal            @db.Decimal(8, 2)
  besideNext     Boolean            @default(false)
  essayLineCount Int?
  section        QuizSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  choices        QuestionChoice[]
  answerKey      AnswerKey?
  rubricCriteria RubricCriterion[]
  answers        SubmissionAnswer[]

  @@unique([sectionId, position])
}

model QuestionChoice {
  id         String   @id @default(cuid())
  questionId String
  label      String
  text       String
  position   Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@unique([questionId, label])
}

model AnswerKey {
  id              String             @id @default(cuid())
  questionId      String             @unique
  acceptedAnswers String[]
  version         Int                @default(1)
  updatedAt       DateTime           @updatedAt
  question        Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  history         AnswerKeyHistory[]
}

model AnswerKeyHistory {
  id              String          @id @default(cuid())
  answerKeyId     String
  changedById     String
  previousAnswers String[]
  newAnswers      String[]
  version         Int
  changedAt       DateTime        @default(now())
  answerKey       AnswerKey       @relation(fields: [answerKeyId], references: [id], onDelete: Restrict)
  changedBy       User            @relation(fields: [changedById], references: [id], onDelete: Restrict)
  resultChanges   ResultHistory[]

  @@unique([answerKeyId, version])
}

model RubricCriterion {
  id          String            @id @default(cuid())
  questionId  String
  title       String
  description String
  maxPoints   Decimal           @db.Decimal(8, 2)
  position    Int
  question    Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  assessments EssayAssessment[]

  @@unique([questionId, position])
}

model CheckingBatch {
  id          String       @id @default(cuid())
  teacherId   String
  quizId      String
  createdAt   DateTime     @default(now())
  teacher     User         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@index([teacherId, createdAt])
}

model PendingPhotoDeletion {
  filePath  String   @id
  createdAt DateTime @default(now())
}

model Submission {
  id             String             @id @default(cuid())
  quizId         String
  studentId      String?
  paperName      String?
  nameReviewed   Boolean            @default(false)
  teacherId      String
  batchId        String?
  expectedPages  Int?
  status         SubmissionStatus   @default(DRAFT)
  objectiveScore Decimal?           @db.Decimal(8, 2)
  essayScore     Decimal?           @db.Decimal(8, 2)
  totalScore     Decimal?           @db.Decimal(8, 2)
  finalizedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  quiz           Quiz               @relation(fields: [quizId], references: [id], onDelete: Restrict)
  student        Student?           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher        User               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  batch          CheckingBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  pages          SubmissionPage[]
  answers        SubmissionAnswer[]
  resultHistory  ResultHistory[]

  @@unique([quizId, studentId])
  @@index([teacherId])
}

model SubmissionPage {
  id           String     @id @default(cuid())
  submissionId String
  pageNumber   Int
  filePath     String
  status       PageStatus @default(PENDING)
  error        String?
  extraction   Json?
  extractionModel String?
  processingStartedAt DateTime?
  processingToken String?
  retryAt DateTime?
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, pageNumber])
}

model SubmissionAnswer {
  id             String            @id @default(cuid())
  submissionId   String
  questionId     String
  extractedText  String?
  confirmedText  String?
  teacherComment String?
  confirmedMarkShape String?
  instructionDecision String?
  reviewStatus   String            @default("PENDING")
  objectiveScore Decimal?          @db.Decimal(8, 2)
  teacherScore   Decimal?          @db.Decimal(8, 2)
  keyVersion     Int?
  submission     Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question       Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)
  assessments    EssayAssessment[]

  @@unique([submissionId, questionId])
}

model EssayAssessment {
  id                String           @id @default(cuid())
  answerId          String
  criterionId       String
  suggestedScore    Decimal?         @db.Decimal(8, 2)
  suggestedFeedback String?
  teacherScore      Decimal?         @db.Decimal(8, 2)
  teacherFeedback   String?
  answer            SubmissionAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  criterion         RubricCriterion  @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([answerId, criterionId])
}

model ResultHistory {
  id                String            @id @default(cuid())
  submissionId      String
  changedById       String
  answerKeyChangeId String?
  reason            String
  previousScore     Decimal?          @db.Decimal(8, 2)
  newScore          Decimal           @db.Decimal(8, 2)
  changedAt         DateTime          @default(now())
  submission        Submission        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  changedBy         User              @relation(fields: [changedById], references: [id], onDelete: Restrict)
  answerKeyChange   AnswerKeyHistory? @relation(fields: [answerKeyChangeId], references: [id], onDelete: Restrict)
}
